# Telegram
TELEGRAM_BOT_TOKEN=replace_me
ADMIN_CHAT_ID=replace_me
TELEGRAM_WEBHOOK_URL=https://your-project.vercel.app/api/telegram
TELEGRAM_WEBHOOK_SECRET=replace_me_with_long_random_string

# Optional Google Sheets integration.
# If these are missing, bot stores leads in crm/leads.csv.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_me
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-bot@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Optional runtime settings
SALON_NAME=Lumi Studio
TIMEZONE=Asia/Novosibirsk

# Optional n8n lead pipeline.
# If URL is set, landing form leads are sent to n8n first.
N8N_BOOKING_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional AI consultant.
# Without these, the bot uses local RAG recommendations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
